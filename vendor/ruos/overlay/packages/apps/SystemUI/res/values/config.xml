<?xml version="1.0" encoding="utf-8"?>
<!--
  SystemUI config overlay — hides Google-specific UI surfaces,
  enables RuOS-specific features.
-->
<resources>
    <!-- Disable the Google QS footer (privacy hub, Google One, etc.) -->
    <bool name="config_quickSettingsShowSessionButton">false</bool>

    <!-- Disable "Hey Google" ambient wake -->
    <bool name="config_voice_recognition_wakeup">false</bool>

    <!-- Remove Google from the power menu -->
    <string-array name="config_globalActionsList">
        <item>power</item>
        <item>restart</item>
        <item>screenshot</item>
        <item>lockdown</item>
        <item>emergency</item>
    </string-array>

    <!-- Use RuOS accent red for SystemUI tint -->
    <color name="system_bar_background_opaque">#FF080808</color>

</resources>
