<?xml version="1.0" encoding="utf-8"?>
<!--
  RuOS framework config overlay.
  Overrides Android defaults for Russian-market behaviour.
-->
<resources>
    <!-- Default launcher component — RuOS Launcher -->
    <string name="config_defaultHomeComponent" translatable="false">com.ruos.launcher/.RuOSLauncherActivity</string>

    <!-- Default SMS app -->
    <string name="default_sms_application" translatable="false">com.ruos.messages</string>

    <!-- Disable Assistant (replaced by Yandex Alice later) -->
    <bool name="config_assistantEnabled">false</bool>

    <!-- Disable Google Cast integration -->
    <bool name="config_enableCastDiscovery">false</bool>

    <!-- Require device authentication for sensitive tiles -->
    <bool name="config_allow_lockscreen_remote_input">false</bool>

    <!-- Allow rotation on all apps by default -->
    <bool name="config_forceDefaultOrientation">false</bool>

    <!-- Default input method — RuOS Keyboard (replaces LatinIME) -->
    <string name="config_defaultInputMethod" translatable="false">com.ruos.keyboard/.RuOSKeyboardService</string>

    <!-- Auto-grant notification-listener access to RuOSNotify on first boot, so the
         Dynamic Island / heads-up banners / home-screen badges work out of the box.
         Without this the whole RuOS notification experience is dead until the user
         manually enables it in Settings — a "feels broken" first-run gap. This is the
         real AOSP mechanism (NotificationManagerService reads it at boot). -->
    <string-array name="config_defaultListenerAccessPackages" translatable="false">
        <item>com.ruos.notify</item>
    </string-array>
</resources>
