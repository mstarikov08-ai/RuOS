android_app {
    name: "RuOSClock",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "34",
    kotlincflags: ["-Xjvm-default=all"],
    static_libs: ["androidx.core_core-ktx"],
    certificate: "platform",
}
