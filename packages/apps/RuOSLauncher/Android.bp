android_app {
    name: "RuOSLauncher",
    srcs: [
        "src/**/*.kt",
        "src/**/*.aidl",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    // platform_apis (not sdk_version) so the RemoteAnimation + SurfaceControl
    // hidden APIs used by the app-open expand resolve. Launcher is privileged +
    // platform-signed, so this is the correct API surface.
    platform_apis: true,
    min_sdk_version: "34",
    kotlincflags: ["-Xjvm-default=all"],
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.dynamicanimation_dynamicanimation",
        "androidx.recyclerview_recyclerview",
        "androidx-constraintlayout_constraintlayout",
        "kotlinx-coroutines-android",
    ],
    optimize: {
        enabled: false,
    },
    privileged: true,
    certificate: "platform",
}
