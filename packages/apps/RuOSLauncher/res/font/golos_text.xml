<?xml version="1.0" encoding="utf-8"?>
<!--
  Golos Text downloadable font via Google Fonts provider.
  Falls back to sans-serif if GMS fonts unavailable.
  Actual TTF files are shipped in the full AOSP build via vendor/ruos/fonts/.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Golos Text&amp;weight=100..700"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>
