<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruos.keychain"
    android:versionCode="10000"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/KeychainTheme"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".ui.KeychainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.CredentialEditActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ui.TotpAddActivity" android:exported="false" android:screenOrientation="portrait" />

        <activity
            android:name=".autofill.AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/TransparentKeychainTheme" />

        <!-- The system autofill provider. -->
        <service
            android:name=".autofill.RuOSAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>
    </application>
</manifest>
