<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruos.backup"
    android:versionCode="10000"
    android:versionName="1.0">

    <!-- Signature-protected permission guarding every app's backup provider: only the
         platform-signed RuOS apps can read/write backup state. -->
    <permission
        android:name="com.ruos.permission.BACKUP"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.ruos.permission.BACKUP" />

    <!-- See the section apps' backup providers (Android 11+ package visibility). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".BackupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ruos.backup.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
