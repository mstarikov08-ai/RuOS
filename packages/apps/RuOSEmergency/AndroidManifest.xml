<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ruos.emergency"
    android:versionCode="10000"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:theme="@style/EmergencyTheme"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!-- Medical ID editor — also the launcher entry. -->
        <activity
            android:name=".ui.MedicalIdEditActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SOS — launchable over the lock screen. -->
        <activity
            android:name=".ui.SosActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <!-- Read-only Medical ID — viewable from the lock screen. -->
        <activity
            android:name=".ui.MedicalIdViewActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait" />
    </application>
</manifest>
