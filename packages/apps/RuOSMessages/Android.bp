android_app {
    name: "RuOSMessages",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "34",
    target_sdk_version: "34",
    kotlincflags: ["-Xjvm-default=all"],
    certificate: "platform",
    privileged: true,
}
